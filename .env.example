# Application
APP_ENV=development
ADMIN_TOKEN=change-me
SESSION_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
MEDIA_ROOT=/data/media
AUTH_ROOT=/data/auth
WEIBO_DETAIL_FALLBACK_LIMIT=3
WEIBO_DETAIL_TIMEOUT_MS=10000
WEIBO_LIST_TIMEOUT_MS=30000
MONITOR_SCAN_INTERVAL=30
MONITOR_CHECK_SOFT_TIME_LIMIT=180
MONITOR_CHECK_TIME_LIMIT=240
MONITOR_QUEUE_WARNING_THRESHOLD=100
MONITOR_QUEUE_CRITICAL_THRESHOLD=500
MEDIA_QUEUE_WARNING_THRESHOLD=500
MEDIA_QUEUE_CRITICAL_THRESHOLD=2000
DAILY_HEALTH_CHECK_HOUR=20
DAILY_HEALTH_CHECK_MINUTE=0
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_POSTS=5
NOTIFICATION_EXCERPT_LENGTH=240
PUBLIC_APP_URL=http://localhost:5173

# PostgreSQL
POSTGRES_IMAGE=postgres:18.4
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=archivelens
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
DATABASE_URL=postgresql+psycopg://<postgres_user>:<postgres_password>@postgres:5432/archivelens

# Redis
REDIS_IMAGE=redis:8.6.3
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<redis_password>
REDIS_URL=redis://:<redis_password>@redis:6379/0

# Notifications
FEISHU_WEBHOOK=
WECOM_WEBHOOK=

# Docker volume paths
# - MEDIA_ROOT maps to ./data/media in docker-compose.yml
# - AUTH_ROOT maps to ./data/auth and stores Playwright login state files such as weibo.json
