# Production deployment for a server that already runs PostgreSQL and Redis.
# Copy to .env.prod on the server and fill real secrets. Do not commit .env.prod.

# Application
APP_ENV=production
ADMIN_TOKEN=replace-with-a-long-random-token
SESSION_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://YOUR_SERVER_IP:10000
MEDIA_ROOT=/data/media
AUTH_ROOT=/data/auth
WEIBO_DETAIL_FALLBACK_LIMIT=3
WEIBO_DETAIL_TIMEOUT_MS=10000
WEIBO_LIST_TIMEOUT_MS=30000
MONITOR_SCAN_INTERVAL=30
MONITOR_CHECK_SOFT_TIME_LIMIT=180
MONITOR_CHECK_TIME_LIMIT=240
MONITOR_QUEUE_WARNING_THRESHOLD=100
MONITOR_QUEUE_CRITICAL_THRESHOLD=500
MEDIA_QUEUE_WARNING_THRESHOLD=500
MEDIA_QUEUE_CRITICAL_THRESHOLD=2000

# Existing PostgreSQL on the same server.
# The prod compose adds host.docker.internal -> host-gateway, so containers can reach host-published ports.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5434
POSTGRES_DB=archivelens
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
DATABASE_URL=postgresql+psycopg://<postgres_user>:<postgres_password>@host.docker.internal:5434/archivelens

# Existing Redis on the same server.
REDIS_HOST=host.docker.internal
REDIS_PORT=6380
REDIS_PASSWORD=<redis_password>
REDIS_URL=redis://:<redis_password>@host.docker.internal:6380/0

# Notifications: leave empty for now.
FEISHU_WEBHOOK=
WECOM_WEBHOOK=
